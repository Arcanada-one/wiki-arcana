{
  "name": "wiki-arcana",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "nest build",
    "lint": "eslint src test scripts prisma.config.ts prisma.migrate.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "prisma:generate": "prisma generate",
    "migrate:deploy": "scripts/migrate.sh",
    "storage:prepare": "tsx scripts/benchmark-storage.ts --mode PREPARE",
    "storage:seed": "tsx scripts/benchmark-storage.ts --mode SEED",
    "storage:benchmark": "tsx scripts/benchmark-storage.ts --mode AUTHORITATIVE",
    "storage:verdict": "tsx scripts/verify-storage-benchmark.ts"
  },
  "dependencies": {
    "@fastify/static": "8.3.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.9.1",
    "dotenv": "17.2.3",
    "fastify": "5.10.0",
    "jose": "6.2.8",
    "pg": "8.16.3",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@types/node": "26.1.1",
    "@types/pg": "8.16.0",
    "eslint": "9.39.2",
    "prisma": "7.9.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=4.1.2",
      "find-my-way": ">=9.7.0",
      "@fastify/static": ">=10.1.1",
      "brace-expansion": ">=5.0.8",
      "ip-address": ">=10.3.1"
    }
  }
}
